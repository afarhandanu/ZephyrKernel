diff --git a/net/mptcp/mib.c b/net/mptcp/mib.c
index fbac6f652..a7ea377dc 100644
--- a/net/mptcp/mib.c
+++ b/net/mptcp/mib.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include <linux/seq_file.h>
+#include <linux/export.h>
 #include <net/ip.h>
 #include <net/mptcp.h>
 #include <net/snmp.h>
@@ -73,6 +74,9 @@ static const struct snmp_mib mptcp_snmp_list[] = {
  * These are allocated when the first mptcp socket is created so
  * we do not waste percpu memory if mptcp isn't in use.
  */
+struct mptcp_mib __percpu *mptcp_stats_global;
+EXPORT_SYMBOL_GPL(mptcp_stats_global);
+
 bool mptcp_mib_alloc(struct net *net)
 {
 	struct mptcp_mib __percpu *mib = alloc_percpu(struct mptcp_mib);
@@ -80,7 +84,7 @@ bool mptcp_mib_alloc(struct net *net)
 	if (!mib)
 		return false;
 
-	if (cmpxchg(&net->mib.mptcp_statistics, NULL, mib))
+	if (cmpxchg(&mptcp_stats_global, NULL, mib))
 		free_percpu(mib);
 
 	return true;
@@ -99,9 +103,9 @@ void mptcp_seq_show(struct seq_file *seq)
 	seq_puts(seq, "\nMPTcpExt:");
 
 	memset(sum, 0, sizeof(sum));
-	if (net->mib.mptcp_statistics)
+	if (mptcp_stats_global)
 		snmp_get_cpu_field_batch(sum, mptcp_snmp_list,
-					 net->mib.mptcp_statistics);
+					 mptcp_stats_global);
 
 	for (i = 0; mptcp_snmp_list[i].name; i++)
 		seq_printf(seq, " %lu", sum[i]);
diff --git a/net/mptcp/mib.h b/net/mptcp/mib.h
index ff08d4114..0c43eb8f3 100644
--- a/net/mptcp/mib.h
+++ b/net/mptcp/mib.h
@@ -68,18 +68,20 @@ struct mptcp_mib {
 	unsigned long mibs[LINUX_MIB_MPTCP_MAX];
 };
 
+extern struct mptcp_mib __percpu *mptcp_stats_global;
+
 static inline void MPTCP_INC_STATS(struct net *net,
 				   enum linux_mptcp_mib_field field)
 {
-	if (likely(net->mib.mptcp_statistics))
-		SNMP_INC_STATS(net->mib.mptcp_statistics, field);
+	if (likely(mptcp_stats_global))
+		SNMP_INC_STATS(mptcp_stats_global, field);
 }
 
 static inline void __MPTCP_INC_STATS(struct net *net,
 				     enum linux_mptcp_mib_field field)
 {
-	if (likely(net->mib.mptcp_statistics))
-		__SNMP_INC_STATS(net->mib.mptcp_statistics, field);
+	if (likely(mptcp_stats_global))
+		__SNMP_INC_STATS(mptcp_stats_global, field);
 }
 
 bool mptcp_mib_alloc(struct net *net);
diff --git a/net/mptcp/protocol.c b/net/mptcp/protocol.c
index c3df888e7..1d6ade5e0 100644
--- a/net/mptcp/protocol.c
+++ b/net/mptcp/protocol.c
@@ -2958,7 +2958,7 @@ static int mptcp_init_sock(struct sock *sk)
 	if (!mptcp_is_enabled(net))
 		return -ENOPROTOOPT;
 
-	if (unlikely(!net->mib.mptcp_statistics) && !mptcp_mib_alloc(net))
+	if (unlikely(!mptcp_stats_global) && !mptcp_mib_alloc(net))
 		return -ENOMEM;
 
 	ret = __mptcp_socket_create(mptcp_sk(sk));
